<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <!-- Базовые цвета -->
        <Color x:Key="BackgroundColor">#FFFFFF</Color>
        <Color x:Key="PanelBackgroundColor">#F8F8F8</Color>
        <Color x:Key="BorderColor">#DDDDDD</Color>

        <!-- Красные акценты (меню) -->
        <Color x:Key="AccentColor">#D32F2F</Color>
        <Color x:Key="AccentDarkColor">#B71C1C</Color>
        <Color x:Key="AccentHoverColor">#FF3B30</Color>

        <!-- Голубые акценты (контент) -->
        <Color x:Key="BlueAccentColor">#2196F3</Color>
        <Color x:Key="BlueAccentDarkColor">#1976D2</Color>
        <Color x:Key="BlueAccentHoverColor">#42A5F5</Color>

        <!-- Текстовые цвета -->
        <Color x:Key="ForegroundColor">#333333</Color>
        <Color x:Key="SecondaryTextColor">#666666</Color>

        <!-- Кисти -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackgroundColor}" />
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />

        <SolidColorBrush x:Key="BlueAccentBrush" Color="{StaticResource BlueAccentColor}" />
        <SolidColorBrush x:Key="BlueAccentDarkBrush" Color="{StaticResource BlueAccentDarkColor}" />
        <SolidColorBrush x:Key="BlueAccentHoverBrush" Color="{StaticResource BlueAccentHoverColor}" />

        <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    </Styles.Resources>

    <!-- === ОСНОВНЫЕ ЭЛЕМЕНТЫ === -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
    </Style>

    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.h1.Main">
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
    </Style>

    <Style Selector="TextBlock.h3">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.h3.Main">
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
    </Style>

    <Style Selector="TextBlock.body">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
    </Style>

    <Style Selector="TextBlock.body.Main">
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
    </Style>

    <Style Selector="TextBlock.button">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- === КНОПКИ МЕНЮ — КРАСНЫЕ === -->
    <Style Selector="Button.MenuButton">
        <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Button.MenuButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    </Style>

    <Style Selector="Button.MenuButton:focus /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentDarkBrush}" />
    </Style>

    <Style Selector="Button.MenuButton:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentDarkBrush}" />
        <Setter Property="Opacity" Value="0.9" />
    </Style>

    <!-- === КНОПКИ КОНТЕНТА — ГОЛУБЫЕ === -->
    <Style Selector="Button:not(.MenuButton)">
        <Setter Property="Background" Value="{StaticResource BlueAccentHoverBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Button:not(.MenuButton):pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BlueAccentBrush}" />
    </Style>

    <Style Selector="Button:not(.MenuButton):focus /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BlueAccentDarkBrush}" />
    </Style>

    <Style Selector="Button:not(.MenuButton):pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BlueAccentDarkBrush}" />
        <Setter Property="Opacity" Value="0.9" />
    </Style>

    <!-- === TEXTBOX === -->
    <Style Selector="TextBox">
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style Selector="TextBox:pointerover /template/ Border">
        <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
    </Style>

    <Style Selector="TextBox:focus /template/ Border">
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="TextBox /template/ TextBlock#PART_Watermark">
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        <Setter Property="FontStyle" Value="Italic" />
    </Style>

    <!-- === LISTBOX ITEM — ВЫДЕЛЕНИЕ СИНИМ (ТОНКАЯ ТЕНЬ) === -->
    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="ListBoxItem:pointerover">
        <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#40000000" BlurRadius="8" OffsetX="0" OffsetY="2" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="ListBoxItem:selected">
        <Setter Property="Background" Value="{StaticResource BlueAccentBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#20000000" BlurRadius="6" OffsetX="0" OffsetY="2" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="ListBoxItem:selected TextBlock">
        <Setter Property="Foreground" Value="White" />
    </Style>

</Styles>