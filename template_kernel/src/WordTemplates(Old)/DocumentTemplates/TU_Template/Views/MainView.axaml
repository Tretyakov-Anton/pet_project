<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:TU_Template.ViewModels"
             xmlns:views="clr-namespace:TU_Template.Views"
             mc:Ignorable="d"
             x:Class="TU_Template.Views.MainView"
             x:DataType="viewmodels:MainViewModel"> <!-- 👈 УКАЗЫВАЕМ ТИП ДАННЫХ ДЛЯ КОМПИЛЯЦИИ -->

    <UserControl.DataTemplates>
        <DataTemplate DataType="{x:Type viewmodels:FileSettingsViewModel}">
            <views:FileSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ElementsViewModel}">
            <views:ElementsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:GroupsViewModel}">
            <views:GroupsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ApplicationGViewModel}">
            <views:ApplicationGView />
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid ColumnDefinitions="200,*" RowDefinitions="*">
        <!-- Вертикальное меню — все кнопки теперь стилизуются через Classes -->
        <StackPanel Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}">
            <Button Content="Настройки файла"
                    Command="{Binding ShowFileSettingsCommand}"
                    Margin="5"
                    Classes="MenuButton" />

            <Button Content="Элементы"
                    Command="{Binding ShowElementsCommand}"
                    Margin="5"
                    Classes="MenuButton" />

            <Button Content="Группы"
                    Command="{Binding ShowGroupsCommand}"
                    Margin="5"
                    Classes="MenuButton" />

            <Button Content="Приложение А"
                    Command="{Binding ShowApplicationA}"
                    Margin="5"
                    Classes="MenuButton" />

            <Button Content="Приложение Б"
                    Command="{Binding ShowApplicationB}"
                    Margin="5"
                    Classes="MenuButton" />

            <Button Content="Приложение В"
                    Command="{Binding ShowApplicationV}"
                    Margin="5"
                    Classes="MenuButton" />

            <Button Content="Приложение Г"
                    Command="{Binding ShowApplicationG}"
                    Margin="5"
                    Classes="MenuButton" />
        </StackPanel>

        <!-- Контейнер для отображения выбранного View -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentView}"
                        Margin="10"/>
    </Grid>
</UserControl>