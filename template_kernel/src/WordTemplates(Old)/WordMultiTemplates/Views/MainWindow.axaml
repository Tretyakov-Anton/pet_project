<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WordMultiTemplates.Views.MainWindow"
        Title="Word Multi Templates" Width="600" Height="150">
	<StackPanel Margin="10">
		<StackPanel Orientation="Horizontal" Spacing="10">
			<ComboBox x:Name="TemplatesComboBox" Width="400" HorizontalAlignment="Stretch" />
			<Button x:Name="CreateButton" Content="Создать" Width="100" />
			<Button x:Name="RefreshButton" Content="Обновить" Width="100" />
		</StackPanel>
	</StackPanel>
</Window>
