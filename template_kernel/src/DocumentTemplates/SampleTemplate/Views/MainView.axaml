<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:SampleTemplate.ViewModels"
             xmlns:views="clr-namespace:SampleTemplate.Views"
             mc:Ignorable="d"
             x:Class="SampleTemplate.Views.MainView">

	<UserControl.DataTemplates>
		<DataTemplate DataType="{x:Type viewmodels:FileSettingsViewModel}">
			<views:FileSettingsView />
		</DataTemplate>
	</UserControl.DataTemplates>
	
	<Grid ColumnDefinitions="200,*" RowDefinitions="*">

		<!-- Вертикальное меню -->
		<StackPanel Grid.Column="0" Background="LightGray">
			<Button Content="Настройки файла"
                    Command="{Binding ShowFileSettingsCommand}"
                    Margin="5"/>
		</StackPanel>

		<!-- Контейнер для отображения выбранного View -->
		<ContentControl Grid.Column="1"
                        Content="{Binding CurrentView}"
                        Margin="10"/>
	</Grid>
</UserControl>
