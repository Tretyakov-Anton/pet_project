defun MTEEE(layer, W1, W3, W2, Extp1,  Extp2, Extp3)
{
	decl Met_1 = db_layerid(11);
	decl VIA = db_layerid(12);
	decl BRG = db_layerid(13);
	decl Met_2 = db_layerid(14);
	decl SEED = db_layerid(15);
	de_set_global_db_factor();
	// Store in local vairable for future use.
	decl dbFact = db_factor();
	decl winInst = api_get_current_window();
	//decl context = de_get_design_context(winInst);
	decl context = de_get_current_design_context();
	decl _W1 = W1 * dbFact ;
	decl _W2 = W2 * dbFact ;
	decl _W3 = W3 * dbFact ;
	decl _W4 = 15;
	decl _W;
	decl _L;

	if (W1 > W3){
		_W = _W1;
	}
	else{
		_W = _W3;
	}
	_L = _W2;

if (layer == "MTEE_Double_Metal"){	
	decl off1;
	decl off2;
	decl off3;
	decl off4;
	


	if (Extp1 == "None"){
		off1 = 1;
	}
	else if (Extp1 == "Extend"){
		off1 = 0;
		
	}
	if (Extp2 == "None"){
		off2 = 1;
	}
	else if (Extp2 == "Extend"){
		off2 = 0;
		
	}
	if (Extp3 == "None"){
		off3 = 1;
	}
	else if (Extp3 == "Extend"){
		off3 = 0;
	}
	off4=1;
	//db_add_rectangle(context, Met_1, 4-4, -_W/2, _W+4-4, _W/2);
	
	db_add_polygon(context);
	db_add_point(context,-4+ 8*off1,  - _W1/2+4);
	db_add_point(context, _L/2 - _W4/2 +4, -_W1/2 +4);
	db_add_point(context, _L/2 - _W4/2 +4, -_W/2 -4 + 8*off4);
	db_add_point(context, _L/2 + _W4/2 -4, -_W/2 -4 + 8*off4);
	db_add_point(context, _L/2 + _W4/2 -4, -_W3/2 +4 );
	db_add_point(context, _L+4 - 8*off3, -_W3/2 +4 );
	db_add_point(context, _L+4 - 8*off3, _W3/2 -4 );
	db_add_point(context, _L/2 + _W2/2 -4, _W3/2 -4 );
	db_add_point(context, _L/2 + _W2/2 -4, _W/2 +4 - 8*off2 );
	db_add_point(context, _L/2 - _W2/2 +4, _W/2 +4 - 8*off2 );
	db_add_point(context, _L/2 - _W2/2 +4, _W1/2 -4 );
	db_add_point(context, -4+ 8*off1, _W1/2 -4 );
	db_end(context, VIA);

	db_add_polygon(context);
	db_add_point(context,-2+ 4*off1,  - _W1/2+2);
	db_add_point(context, _L/2 - _W4/2 +2, -_W1/2 +2);
	db_add_point(context, _L/2 - _W4/2 +2, -_W/2 -2 + 4*off4);
	db_add_point(context, _L/2 + _W4/2 -2, -_W/2 -2 + 4*off4);
	db_add_point(context, _L/2 + _W4/2 -2, -_W3/2 +2 );
	db_add_point(context, _L+2 - 4*off3, -_W3/2 +2 );
	db_add_point(context, _L+2 - 4*off3, _W3/2 -2 );
	db_add_point(context, _L/2 + _W2/2 -2, _W3/2 -2 );
	db_add_point(context, _L/2 + _W2/2 -2, _W/2 +2 - 4*off2 );
	db_add_point(context, _L/2 - _W2/2 +2, _W/2 +2 - 4*off2 );
	db_add_point(context, _L/2 - _W2/2 +2, _W1/2 -2 );
	db_add_point(context, -2+ 4*off1, _W1/2 -2 );
	db_end(context, Met_2);

	db_add_polygon(context);
	db_add_point(context, -3 + 4*off1,  - _W1/2+1);
	db_add_point(context, _L/2 - _W4/2 +1, -_W1/2 +1);
	db_add_point(context, _L/2 - _W4/2 +1, -_W/2 -3 + 4*off4);
	db_add_point(context, _L/2 + _W4/2 -1, -_W/2 -3 + 4*off4);
	db_add_point(context, _L/2 + _W4/2 -1, -_W3/2 +1);
	db_add_point(context, _L+3 - 4*off3, -_W3/2 +1);
	db_add_point(context, _L+3 - 4*off3, _W3/2 -1 );
	db_add_point(context, _L/2 + _W2/2 -1, _W3/2 -1 );
	db_add_point(context, _L/2 + _W2/2 -1, _W/2 +3 - 4*off2 );
	db_add_point(context, _L/2 - _W2/2 +1, _W/2 +3 - 4*off2 );
	db_add_point(context, _L/2 - _W2/2 +1, _W1/2 -1 );
	db_add_point(context, -3+ 4*off1, _W1/2 -1 );
	db_end(context, BRG);

	db_add_polygon(context);
	db_add_point(context, -5 + 4*off1,  - _W1/2 - 1);
	db_add_point(context, _L/2 - _W4/2 - 1, -_W1/2 - 1);
	db_add_point(context, _L/2 - _W4/2 - 1, -_W/2 -5 + 4*off4);
	db_add_point(context, _L/2 + _W4/2 + 1, -_W/2 -5 + 4*off4);
	db_add_point(context, _L/2 + _W4/2 + 1, -_W3/2 - 1);
	db_add_point(context, _L + 5 - 4*off3, -_W3/2 - 1);
	db_add_point(context, _L + 5 - 4*off3, _W3/2 +1);
	db_add_point(context, _L/2 + _W2/2 + 1, _W3/2 +1 );
	db_add_point(context, _L/2 + _W2/2 + 1, _W/2 + 5 - 4*off2 );
	db_add_point(context, _L/2 - _W2/2  - 1, _W/2 +5 - 4*off2 );
	db_add_point(context, _L/2 - _W2/2  - 1, _W1/2 + 1);
	db_add_point(context, -5 + 4*off1, _W1/2 + 1);
	db_end(context, SEED);
	
	db_add_polygon(context);
	db_add_point(context,0,  - _W1/2+0);
	db_add_point(context, _L/2 - _W4/2 +0, -_W1/2 +0);
	db_add_point(context, _L/2 - _W4/2 +0, -_W/2 );
	db_add_point(context, _L/2 + _W4/2 -0, -_W/2 );
	db_add_point(context, _L/2 + _W4/2 -0, -_W3/2 +0 );
	db_add_point(context, _L+0, -_W3/2 +0 );
	db_add_point(context, _L+0, _W3/2 -0 );
	db_add_point(context, _L/2 + _W2/2 -0, _W3/2 -0 );
	db_add_point(context, _L/2 + _W2/2 -0, _W/2  );
	db_add_point(context, _L/2 - _W2/2 +0, _W/2  );
	db_add_point(context, _L/2 - _W2/2 +0, _W1/2 -0 );
	db_add_point(context, 0, _W1/2 -0 );
	db_end(context, Met_1);

	//de_draw_port(0,0 , 180, , 1);
	//de_draw_port((W/2) ,(W/2), 0, , 2);
	//de_draw_port((W) ,0, -90, , 3);
	decl pin1 = db_create_pin(context, 0,0 , NULL, Met_1, 1);
	decl pin2 = db_create_pin(context, _L/2,_W/2 , NULL, Met_1, 2);	
	decl pin3 = db_create_pin(context, _L ,0, NULL, Met_1, 3);	
	//decl pin4 = db_create_pin(context, _L/2,-_W/2 , NULL, Met_1, 4);	
}
else if (layer == "MTEE_MET1"){
	db_add_polygon(context);
	db_add_point(context,-0,  - _W1/2 - 0);
	db_add_point(context, _L/2 - _W4/2 +0, -_W1/2 - 0);
	db_add_point(context, _L/2 - _W4/2 +0, -_W/2 -0);
	db_add_point(context, _L/2 + _W4/2 -0, -_W/2 -0);
	db_add_point(context, _L/2 + _W4/2 -0, -_W3/2 +0);
	db_add_point(context, _L+0 , -_W3/2 +0);
	db_add_point(context, _L+0 , _W3/2 -0);
	db_add_point(context, _L/2 + _W2/2 -0, _W3/2 -0);
	db_add_point(context, _L/2 + _W2/2 -0, _W/2 +0);
	db_add_point(context, _L/2 - _W2/2 +0, _W/2 +0);
	db_add_point(context, _L/2 - _W2/2 +0, _W1/2 -0);
	db_add_point(context, -0, _W1/2 - 0 );
	db_end(context, Met_1);

	//de_draw_port(0,0 , 180, , 1);
	//de_draw_port((W/2) ,(W/2), 0, , 2);
	//de_draw_port((W) ,0, -90, , 3);
	decl pin1 = db_create_pin(context, 0,0 , NULL, Met_1, 1);
	decl pin2 = db_create_pin(context, _L/2, _W/2 , NULL, Met_1, 2);	
	decl pin3 = db_create_pin(context, _L ,0, NULL, Met_1, 3);	
	//decl pin4 = db_create_pin(context, _L/2,-_W/2 , NULL, Met_1, 4);		
}
else if (layer == "MTEE_MET2"){
	// === Met_2 (базовый слой) ===
	db_add_polygon(context);
	db_add_point(context, -0 , -_W1/2 + 0 );
	db_add_point(context, _L/2 - _W4/2 +0,- _W1/2 + 0 );
	db_add_point(context, _L/2 - _W4/2 +0,-_W/2 - 0 );
	db_add_point(context, _L/2 + _W4/2 -0,-_W/2 - 0 );
	db_add_point(context, _L/2 + _W4/2 -0,-_W3/2 + 0 );
	db_add_point(context, _L+0 ,-_W3/2 + 0 );
	db_add_point(context, _L+0 ,_W3/2 - 0 );
	db_add_point(context, _L/2 + _W2/2 -0,_W3/2 - 0 );
	db_add_point(context, _L/2 + _W2/2 -0,_W/2 + 0 );
	db_add_point(context, _L/2 - _W2/2 +0,_W/2 + 0 );
	db_add_point(context, _L/2 - _W2/2 +0,_W1/2 - 0 );
	db_add_point(context, -0,_W1/2 - 0 );
	db_end(context, Met_2);

	db_add_polygon(context);
	db_add_point(context, -1,-(_W1/2 + 1) );
	db_add_point(context, _L/2 - (_W4/2 + 1), +0 -(_W1/2 + 1) );
	db_add_point(context, _L/2 - (_W4/2 + 1) +0,-((_W/2 + 1)/2*2 - 0) );
	db_add_point(context, _L/2 + (_W4/2 + 1),-((_W/2 + 1)/2*2-0));
	db_add_point(context, _L/2 +(_W4/2 + 1),-(_W3/2 + 1) );
	db_add_point(context, _L+1 ,-(_W3/2 + 1) );
	db_add_point(context, _L+1 ,(_W3/2 - 1) );
	db_add_point(context, _L/2 + _W2/2 +1,(_W3/2 - 1));
	db_add_point(context, _L/2 + _W2/2 +1,(_W/2 + 1) + 0);
	db_add_point(context, _L/2 - _W2/2 -1,(_W/2 + 1) + 0);
	db_add_point(context, _L/2 - _W2/2 -1,(_W1/2 - 1));
	db_add_point(context, -1,(_W1/2 - 1) );
	db_end(context, BRG);


	db_add_polygon(context);
	db_add_point(context, -3,-(_W1/2 + 3) );
	db_add_point(context, _L/2 - (_W4/2 + 3), +0 -(_W1/2 + 3) );
	db_add_point(context, _L/2 - (_W4/2 + 3) +0,-((_W/2 + 3)/2*2 - 0) );
	db_add_point(context, _L/2 + (_W4/2 + 3),-((_W/2 + 3)/2*2-0));
	db_add_point(context, _L/2 +(_W4/2 + 3),-(_W3/2 + 3) );
	db_add_point(context, _L+3,-(_W3/2 + 3) );
	db_add_point(context, _L+3,(_W3/2 - 3) );
	db_add_point(context, _L/2 + _W2/2 +3,(_W3/2 - 3));
	db_add_point(context, _L/2 + _W2/2 +3,(_W/2 + 3) + 0);
	db_add_point(context, _L/2 - _W2/2 -3,(_W/2 + 3) + 0);
	db_add_point(context, _L/2 - _W2/2 -3,(_W1/2 - 3));
	db_add_point(context, -3,(_W1/2 - 3) );
	db_end(context, SEED);

	//de_draw_port(0,0 , 180, , 1);
	//de_draw_port((W/2) ,(W/2), 0, , 2);
	//de_draw_port((W) ,0, -90, , 3);
	decl pin1 = db_create_pin(context, 0,0 , NULL, Met_2, 1);
	decl pin2 = db_create_pin(context, _L/2,_W/2 , NULL, Met_2, 2);	
	decl pin3 = db_create_pin(context, _L ,0, NULL, Met_2, 3);	
	//decl pin4 = db_create_pin(context, _L/2,-_W/2 , NULL, Met_2, 4);	
	}
}
