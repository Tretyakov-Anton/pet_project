<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:DocumentTemplates.ViewModels"
    xmlns:core="clr-namespace:DocumentTemplates.CoreLibrary;assembly=DocumentTemplates.CoreLibrary"
    Width="800"
    Height="500"
    x:Class="DocumentTemplates.Views.MainWindow"
    Title="Шаблоны документов"
    Icon="avares://DocumentTemplates.CoreLibrary/Assets/Icons/icvao.ico"
    WindowStartupLocation="CenterScreen"
    x:DataType="vm:MainWindowViewModel"> 

    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>

    <DockPanel Margin="20">

        <!-- Заголовок + переключатель темы -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock Grid.Column="0"
                       Text="Выберите шаблон документа"
                       Classes="h1 Main"/>

            <Button Grid.Column="1"
                    x:Name="ThemeToggleButton"
                    Content="Светлая тема"
                    Height="34"
                    Width="160"
                    Classes="MenuButton"
                    IsVisible="False"
                    Click="OnToggleThemeClick"/>
        </Grid>

        <!-- Кнопки действий -->
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                <Button
                    Command="{Binding OpenTemplateCommand}"
                    IsEnabled="{Binding CanOpenTemplate}"
                    HorizontalAlignment="Stretch"
                    Height="44"
                    Margin="0,20,0,0"
                    Classes="MenuButton">
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <TextBlock Text="Открыть выбранный шаблон" Classes="button" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button
                    Click="OnAddModuleClick"
                    HorizontalAlignment="Stretch"
                    Height="44"
                    Margin="0,20,0,0"
                    Classes="MenuButton">
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <TextBlock Text="Добавить модуль шаблона (.dll)" Classes="button" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Иконка переключения темы справа снизу -->
            <Button Grid.Column="1"
                    x:Name="ThemeIconToggleButton"
                    Width="34"
                    Height="34"
                    Margin="0,0,0,20"
                    Classes="ThemeIconToggle"
                    Click="OnToggleThemeClick"
                    ToolTip.Tip="Переключить тему">
                <Image Width="18"
                       Height="18"
                       Source="avares://DocumentTemplates.CoreLibrary/Assets/Icons/icon_color_change.ico"/>
            </Button>
        </Grid>

        <!-- Поиск -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource PanelBackgroundBrush}"
                CornerRadius="10"
                Padding="10"
                BorderThickness="1"
                BorderBrush="{StaticResource BorderBrush}"
                Margin="0,0,0,20">
            <StackPanel Spacing="10">
                <TextBlock Text="Поиск"
                           Classes="h3 Main"
                           Margin="0,0,0,5" />
                <TextBox
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                    Watermark="Введите название..."
                    CornerRadius="6"
                    Padding="6"
                    Background="{StaticResource BackgroundBrush}"
                    BorderThickness="0"
                    VerticalContentAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Список шаблонов -->
        <Border CornerRadius="8" Padding="0">
            <ListBox ItemsSource="{Binding Templates}"
                     SelectedItem="{Binding SelectedTemplate}">

                <!-- Карточка элемента -->
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="core:IDocumentTemplate">
                        <Border Padding="15,12"
                                CornerRadius="6"
                                Background="{Binding $parent[ListBoxItem].Background}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding Metadata.Name}"
                                           Classes="h3 Main"/>
                                <TextBlock Text="{Binding Metadata.Description}"
                                           Classes="body Main"
                                           MaxHeight="40"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>
        </Border>
    </DockPanel>
</Window>