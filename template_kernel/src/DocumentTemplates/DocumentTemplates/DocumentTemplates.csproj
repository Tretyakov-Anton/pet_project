<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Иконка exe: её же подхватывают ярлыки на рабочем столе и в меню «Пуск» -->
    <ApplicationIcon>..\DocumentTemplates.CoreLibrary\Assets\Icons\icvao.ico</ApplicationIcon>
    <AssemblyTitle>Шаблоны документов</AssemblyTitle>
    <Product>Шаблоны документов</Product>
    <Company>ООО «ИПК «Электрон-Маш»</Company>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <UserSecretsId>457b11f9-049b-4d88-9e82-ab5065b866c5</UserSecretsId>
  </PropertyGroup>

 <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="ReactiveUI.Avalonia" Version="12.1.6" />
    <PackageReference Include="DocX" Version="3.0.0" />
    <PackageReference Include="System.Reactive" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DocumentTemplates.CoreLibrary\DocumentTemplates.CoreLibrary.csproj" />
  </ItemGroup>
</Project>