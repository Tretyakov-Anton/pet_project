<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:TU_Template.ViewModels"
             x:Class="TU_Template.Views.FileSettingsView"
             x:DataType="viewmodels:FileSettingsViewModel"
             Classes="AdminContent">

	<ScrollViewer VerticalScrollBarVisibility="Auto">
		<StackPanel Spacing="12">

			<Grid RowDefinitions="auto auto auto" ColumnDefinitions="auto * auto">
				<TextBlock Grid.Row="0" Grid.Column="0" Text="Название проекта" VerticalAlignment="Center" />
				<TextBox Grid.Row="0" Grid.Column="1" Margin="8 0 8 0"
						 Text="{Binding Path=ProjectName}"
						 Watermark="Так будет назван и файл проекта, и готовый документ Word" />

				<TextBlock Grid.Row="1" Grid.Column="0" Text="Шаблон документа" Margin="0 8 0 0" VerticalAlignment="Center" />
				<TextBox Grid.Row="1" Grid.Column="1" Margin="8 8 8 0"
						 Text="{Binding Path=SourcePath}"
						 Watermark="Файл .docx, по которому собирается документ" />
				<Button Grid.Row="1" Grid.Column="2" Content="Выбрать файл шаблона…" Margin="0 8 0 0"
						Command="{Binding Path=SelectSourceFileCommand}" />

				<TextBlock Grid.Row="2" Grid.Column="0" Text="Папка для готовых документов" Margin="0 8 0 0"
						   VerticalAlignment="Center" />
				<TextBox Grid.Row="2" Grid.Column="1" Margin="8 8 8 0"
						 Text="{Binding Path=ResultPath}"
						 Watermark="Куда класть созданные файлы Word" />
				<Button Grid.Row="2" Grid.Column="2" Content="Выбрать папку…" Margin="0 8 0 0"
						Command="{Binding Path=SelectResultFolderCommand}" />
			</Grid>

			<Button Margin="2 8 2 0" FontSize="16" Padding="0 10"
					Command="{Binding Path=CreateCommand}"
					HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
				Создать документ Word по шаблону
			</Button>

			<!-- Виден только после того, как документ создан -->
			<Grid ColumnDefinitions="* *" IsVisible="{Binding Path=HasLastDocument}">
				<Button Grid.Column="0" Margin="2 0" Padding="0 8"
						Command="{Binding Path=OpenDocumentCommand}"
						HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
					Открыть созданный документ в Word
				</Button>
				<Button Grid.Column="1" Margin="2 0" Padding="0 8"
						Command="{Binding Path=ShowDocumentInFolderCommand}"
						HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
					Показать документ в папке
				</Button>
			</Grid>

			<Separator Margin="0 8" />

			<Grid ColumnDefinitions="* *">
				<Button Grid.Column="0" Margin="2 0" FontSize="14" Padding="0 10"
						Command="{Binding Path=LoadCommand}"
						HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
					Открыть проект из файла
				</Button>
				<Button Grid.Column="1" Margin="2 0" FontSize="14" Padding="0 10"
						Command="{Binding Path=SaveCommand}"
						HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
					Сохранить проект в файл
				</Button>
			</Grid>

			<Border Classes="AdminSubCard" Padding="12 10" Margin="2 4 2 0">
				<StackPanel Spacing="6">
					<TextBlock Text="{Binding Path=SaveStateText}" FontWeight="SemiBold" />
					<TextBlock Text="{Binding Path=ProjectFileDisplay}" FontSize="12" Opacity="0.75"
							   TextWrapping="Wrap" />
					<TextBlock Text="{Binding Path=StatusText}" TextWrapping="Wrap" FontSize="12" />
					<TextBlock Text="Проект сохраняется автоматически через пару секунд после последнего изменения."
							   FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
				</StackPanel>
			</Border>

		</StackPanel>
	</ScrollViewer>
</UserControl>
