<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TU_Template.ViewModels"
             xmlns:m="clr-namespace:TU_Template.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TU_Template.Views.GroupsView"
             x:Name="Root"
             Classes="AdminContent">
    
    <UserControl.Styles>
    <Style Selector="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="* auto">
        <ScrollViewer Margin="2 0" Padding="0 0 8 0" Grid.IsSharedSizeScope="True">
            <ItemsControl ItemsSource="{Binding Path=TemplateData.Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="AdminListItem"
                                Padding="6" Margin="0 0 0 12"
                                Name="GroupRoot">
                            <StackPanel>
                                <Grid Margin="0 0 0 0"
                                      ColumnDefinitions="auto *" RowDefinitions="auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0 0 8 0"
                                               Text="Название:" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0 0 0 0"
                                             Text="{Binding Path=Name}" VerticalAlignment="Center" />
                                </Grid>

                                <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
                                
                                <Panel Classes="AdminSeparator" Height="0.8" HorizontalAlignment="Stretch" Margin="0 8 0 8" />

                                <TextBlock HorizontalAlignment="Center" Margin="0 0 0 8">
                                    Электрические параметры микросхем
                                </TextBlock>

                                <Grid IsVisible="{Binding Path=ElectricalParameters.Count}"
                                      ColumnDefinitions="3* * * 100" Margin="0 0 0 0">
                                    <TextBlock Grid.Column="0" Margin="0 0 4 0"
                                               TextAlignment="Center" Text="Название" />
                                    <TextBlock Grid.Column="1" Margin="0 0 4 0"
                                               TextAlignment="Center" Text="Обозначение" />
                                    <TextBlock Grid.Column="2" Margin="0 0 4 0"
                                               TextAlignment="Center" Text="Температура" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Path=ElectricalParameters}"
                                              Margin="0 4 0 0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="3* * * 100" Margin="0 0 0 4">
                                                <TextBox Grid.Column="0" Text="{Binding Path=Name}"
                                                         VerticalAlignment="Center" Margin="0 0 4 0" />
                                                <TextBox Grid.Column="1" Text="{Binding Path=Symbol}"
                                                         VerticalAlignment="Center" Margin="0 0 4 0" />
                                                <TextBox Grid.Column="2" Text="{Binding Path=Temp}"
                                                         VerticalAlignment="Center" Margin="0 0 4 0" />
                                                <Button Grid.Column="3" Padding="16 0"
                                                        Command="{Binding DataContext.RemoveElectricalParameterCommand, ElementName=GroupRoot}"
                                                        CommandParameter="{Binding}"
                                                        Content="Удалить"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center">
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Margin="0 0 10 0" Padding="16 0"
                                            HorizontalAlignment="Right"
                                            Width="200"
                                            Height="30"
                                            Command="{Binding DataContext.AddElectricalParameterCommand, ElementName=GroupRoot}"
                                            Content="Добавить параметр в таблицу"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center">
                                    </Button>
                                    <Button Margin="0 0 0 0"
                                            Padding="16 0" HorizontalAlignment="Right"
                                            Width="200"
                                            Height="30"
                                            Command="{Binding DataContext.AddElectricalParametersNoteCommand, ElementName=GroupRoot}"
                                            Content="Добавить примечание под таблицей"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center">
                                    </Button>
                                </StackPanel>
                                
                                <ItemsControl ItemsSource="{Binding Path=ElectricalParametersNotes}"
                                              Margin="0 12 0 0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="* 100" Margin="0 0 0 4">
                                                <TextBox Grid.Column="0" Text="{Binding Path=Text}"
                                                         VerticalAlignment="Center" Margin="0 0 4 0" />
                                                <Button Grid.Column="1" Padding="16 0"
                                                        Command="{Binding DataContext.RemoveElectricalParametersNoteCommand, ElementName=GroupRoot}"
                                                        CommandParameter="{Binding}"
                                                        Content="Удалить"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center">
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                               

                                <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

                                <Panel Classes="AdminSeparator" Height="0.8" HorizontalAlignment="Stretch" Margin="0 8 0 8" />

                                <TextBlock HorizontalAlignment="Center" Margin="0 0 0 8">
                                    Предельно допустимые и предельные значения электрических режимов эксплуатации микросхем
                                </TextBlock>

                                <Grid IsVisible="{Binding Path=OperatingConditionsParameters.Count}"
                                      ColumnDefinitions="1.5* * * * * * * 100" RowDefinitions="auto auto"
                                      Margin="0 0 0 0">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Margin="0 0 4 0"
                                               TextAlignment="Center" Text="Название" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Margin="0 0 4 0"
                                               TextAlignment="Center" Text="Обозначение" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2"
                                               Margin="0 0 4 0"
                                               TextAlignment="Center" Text="Предельно допустимый режим" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Margin="0 0 4 0"
                                               TextAlignment="Center" Text="не менее" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" Margin="0 0 4 0"
                                               TextAlignment="Center" Text="не более" />
                                    <TextBlock Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="2"
                                               Margin="0 0 4 0"
                                               TextAlignment="Center" Text="Предельнй режим" />
                                    <TextBlock Grid.Row="1" Grid.Column="4" Margin="0 0 4 0"
                                               TextAlignment="Center" Text="не менее" />
                                    <TextBlock Grid.Row="1" Grid.Column="5" Margin="0 0 4 0"
                                               TextAlignment="Center" Text="не более" />
                                    <TextBlock Grid.Row="0" Grid.Column="6" Grid.RowSpan="2" Margin="0 0 4 0"
                                               TextAlignment="Center" Text="Примечания" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Path=OperatingConditionsParameters}"
                                              Margin="0 4 0 0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="1.5* * * * * * * 100" Margin="0 0 0 4">
                                                <TextBox Grid.Column="0" Text="{Binding Path=Name}"
                                                         VerticalAlignment="Center" Margin="0 0 4 0" />
                                                <TextBox Grid.Column="1" Text="{Binding Path=Symbol}"
                                                         VerticalAlignment="Center" Margin="0 0 4 0" />
                                                <TextBox Grid.Column="2"
                                                         Text="{Binding Path=MaximumPermissible.AtLeast}"
                                                         VerticalAlignment="Center" Margin="0 0 4 0" />
                                                <TextBox Grid.Column="3"
                                                         Text="{Binding Path=MaximumPermissible.AtMost}"
                                                         VerticalAlignment="Center" Margin="0 0 4 0" />
                                                <TextBox Grid.Column="4" Text="{Binding Path=Limit.AtLeast}"
                                                         VerticalAlignment="Center" Margin="0 0 4 0" />
                                                <TextBox Grid.Column="5" Text="{Binding Path=Limit.AtMost}"
                                                         VerticalAlignment="Center" Margin="0 0 4 0" />
                                                <TextBox Grid.Column="6" Text="{Binding Path=NoteRefs}"
                                                         VerticalAlignment="Center" Margin="0 0 4 0" />
                                                <Button Grid.Column="7" Padding="16 0"
                                                        Command="{Binding DataContext.RemoveOperatingConditionsParameterCommand, ElementName=GroupRoot}"
                                                        CommandParameter="{Binding}"
                                                        Content="Удалить"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center">
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- Сюда добавить -->
                                
                                
                                
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Margin="0 0 10 0" Padding="16 0"
                                            HorizontalAlignment="Right"
                                            Width="200"
                                            Height="30"
                                            Command="{Binding DataContext.AddOperatingConditionsParameterCommand, ElementName=GroupRoot}"
                                            Content="Добавить параметр в таблицу"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center">
                                    </Button>
                                    <Button Margin="0 0 0 0"
                                            Padding="16 0" HorizontalAlignment="Right"
                                            Width="200"
                                            Height="30"
                                            Command="{Binding DataContext.AddOperatingConditionsParametersNoteCommand, ElementName=GroupRoot}"
                                            Content="Добавить примечание под таблицей"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center">
                                    </Button>
                                </StackPanel>
                                
                                <ItemsControl ItemsSource="{Binding Path=OperatingConditionsParametersNotes}"
                                              Margin="0 12 0 0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="* 100" Margin="0 0 0 4">
                                                <TextBox Grid.Column="0" Text="{Binding Path=Text}"
                                                         VerticalAlignment="Center" Margin="0 0 4 0" />
                                                <Button Grid.Column="1" Padding="16 0"
                                                        Command="{Binding DataContext.RemoveOperatingConditionsParametersNoteCommand, ElementName=GroupRoot}"
                                                        CommandParameter="{Binding}"
                                                        Content="Удалить"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center">
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                              
                                <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

                                <Panel Classes="AdminSeparator" Height="0.8" HorizontalAlignment="Stretch" Margin="0 8 0 8" />

                                <TextBlock HorizontalAlignment="Center" Margin="0 0 0 8">
                                    Нормы и режимы измерения электрических параметров при испытаниях микросхем
                                </TextBlock>

                                <!-- Заголовки столбцов: последней колонке даём больше места, контент — мин. ширина для всех заголовков -->
                                <Grid ColumnDefinitions="2* * * 1.5* 4*" Margin="0 0 0 4" IsVisible="{Binding ElectricalParameters.Count}">
                                    <TextBlock Grid.Column="0" Text="Наименование" TextAlignment="Center" Margin="0 0 4 0" />
                                    <TextBlock Grid.Column="1" Text="Обозначение" TextAlignment="Center" Margin="0 0 4 0" />
                                    <TextBlock Grid.Column="2" Text="Температура" TextAlignment="Center" Margin="0 0 4 0" />
                                    <TextBlock Grid.Column="3" Text="Погрешность, %" TextAlignment="Center" Margin="0 0 4 0" />
                                    <ScrollViewer Grid.Column="4" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding MeasurementModeColumnHeaders}" MinWidth="420">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" MinWidth="420" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" TextAlignment="Center" MinWidth="60" Margin="2 0" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding ElectricalParameters}" Margin="0 4 0 0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="2* * * 1.5* 4*" Margin="0 0 0 4">
                                                <TextBox Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" Margin="0 0 4 0" />
                                                <TextBox Grid.Column="1" Text="{Binding Symbol}" VerticalAlignment="Center" Margin="0 0 4 0" />
                                                <TextBox Grid.Column="2" Text="{Binding Temp}" VerticalAlignment="Center" Margin="0 0 4 0" />
                                                <TextBox Grid.Column="3" Text="{Binding MeasurementError}" VerticalAlignment="Center" Margin="0 0 4 0" />
                                                <ScrollViewer Grid.Column="4" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                                    <ItemsControl ItemsSource="{Binding MeasurementModeValues}" MinWidth="420">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" MinWidth="420" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBox Text="{Binding Value}" MinWidth="60" Margin="2 0" VerticalAlignment="Center" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Значения столбцов «Режим измерения» (в т.ч. fвх, Rн) задаются здесь; при генерации документа используются эти значения или значения из таблицы операционных условий."
                                           FontSize="11" TextWrapping="Wrap" Margin="0 8 0 0" Foreground="#666" />

                                <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

                          <Panel Classes="AdminSeparator" Height="0.8" HorizontalAlignment="Stretch" Margin="0 8 0 8" />

                          <TextBlock HorizontalAlignment="Center" Margin="0 0 0 8">
                             Схема включения при испытании на безотказность и долговечность
                             НЕ РАБОТАЕТ
                          </TextBlock>

                          <!-- Тут долны быть:
                               Изображение
                              Список подписей(пример: G1-генератор)
                          -->
                                <!-- Снизу закоментирована контрукция по добавлению комментарий 
                            Когда будет создан функционал для генерации добавляем его и менят биндинги скорее всего-->
                                <!--
                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Margin="0 0 10 0" Padding="16 0"
                                            HorizontalAlignment="Right"
                                            Width="200"
                                            Height="30"
                                            Command="{Binding Path= #GroupRoot.((m:Group)DataContext).AddOperatingConditionsParameterCommand}">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                            Добавить комментарий
                                        </TextBlock>
                                    </Button>
                                </StackPanel>
                                -->
                          <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

                          <Panel Classes="AdminSeparator" Height="0.8" HorizontalAlignment="Stretch" Margin="0 8 0 8" />

                          <TextBlock HorizontalAlignment="Center" Margin="0 0 0 8">
                             Схема включения при измерении электрических параметров
                             НЕ РАБОТАЕТ
                          </TextBlock>

                          <!-- Тут долны быть:
                               Изображение
                              Список подписей(пример: G1-генератор)
                          -->

                          <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

                          <Panel Classes="AdminSeparator" Height="0.8" HorizontalAlignment="Stretch" Margin="0 8 0 8" />

                          <TextBlock HorizontalAlignment="Center" Margin="0 0 0 8">
                             Условное графическое обозначение и функциональное назначение выводов
                             НЕ РАБОТАЕТ
                          </TextBlock>

                          <!-- Тут долны быть:
                               Изображение
                              Таблица с выводами
                          -->

                          <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

                          <Panel Classes="AdminSeparator" Height="0.8" HorizontalAlignment="Stretch" Margin="0 8 0 8" />

                          <TextBlock HorizontalAlignment="Center" Margin="0 0 0 8">
                             Типовая схема включения
                             НЕ РАБОТАЕТ
                          </TextBlock>

                          <!-- Тут долны быть:
                               Изображение
                              Список подписей(пример: G1-генератор)
                          -->

                          <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
                          
                                <Panel Classes="AdminSeparator" Height="0.8" HorizontalAlignment="Stretch" Margin="0 8 0 8" />

                          
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Margin="0 0 10 0" Padding="16 0"
                                            HorizontalAlignment="Right"
                                            Width="200"
                                            Height="30"
                                            Command="{Binding DataContext.RemoveCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"
                                            Content="Удалить эту группу"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center">
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="1" Margin="2 8 2 0" FontSize="16" Padding="0 8"
                Command="{Binding Path=AddCommand}"
                HorizontalAlignment="Stretch" 
                Content="Добавить"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center">
        </Button>
    </Grid>
</UserControl>
